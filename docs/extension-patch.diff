+// ---------------------------------------------------------------------------
+// LOCAL PATCH (PDF Supplier experiment, 2026-11-13). Not part of upstream.
+//
+// Problem: the side panel only learns about tools through the TOP frame's
+// getTools({ fromOrigins }), which returns a subframe's tools only if that
+// subframe exposed them to the top origin. Stripe Checkout registers
+// `fill_payment_form` in an iframe after a payment method is selected, and it
+// never reaches the agent (see the PDF Supplier docs, agent run 2).
+//
+// Patch: a subframe on an allow-listed origin also reports the tools it
+// registered itself, now and whenever they change. The side panel accepts
+// these reports only when Chrome's own record of the frame URL and the tab URL
+// are both on an allow-listed origin (see useActiveTabTools.ts).
+const PATCH_SUBFRAME_TOOL_ORIGINS = /^https:\/\/([a-z0-9-]+\.)*stripe\.com$/;
+
+if (window !== window.top && PATCH_SUBFRAME_TOOL_ORIGINS.test(window.location.origin) && document.modelContext) {
+  const modelContext = document.modelContext;
+  let reportTimeout: ReturnType<typeof setTimeout> | undefined;
+  const reportOwnTools = () => {
+    clearTimeout(reportTimeout);
+    reportTimeout = setTimeout(async () => {
+      try {
+        const own = (await modelContext.getTools()).filter((tool) => tool.window === window);
+        const subframeTools = own.map((tool) => ({
+          description: tool.description,
+          inputSchema: tool.inputSchema,
+          readOnlyHint: tool.annotations?.readOnlyHint,
+          untrustedContentHint: tool.annotations?.untrustedContentHint,
+          consequentialHint: tool.annotations?.consequentialHint,
+          name: tool.name,
+        }));
+        console.debug(`[WebMCP patch] Subframe ${window.location.origin} reports ${subframeTools.length} own tools`);
+        chrome.runtime.sendMessage({ subframeTools }).catch(() => {});
+      } catch (error) {
+        console.debug('[WebMCP patch] Subframe tool report failed:', toMessage(error));
+      }
+    }, 150);
+  };
+  (modelContext as unknown as EventTarget).addEventListener('toolchange', reportOwnTools);
+  reportOwnTools();
+}
