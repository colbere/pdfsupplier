+// LOCAL PATCH (PDF Supplier experiment): emptyTimeoutMs.
+test('waitForToolsToSettle with emptyTimeoutMs keeps waiting while a navigated-to page has no tools yet', async () => {
+  const toolsRef: { current: { name: string }[] } = { current: [] };
+  const options = { requestTools: async () => {}, quietMs: 50, pollMs: 5, timeoutMs: 100 };
+
+  // Tools arrive after the normal timeout but before emptyTimeoutMs.
+  setTimeout(() => {
+    toolsRef.current = [{ name: 'get_order_summary' }];
+  }, 300);
+  let start = performance.now();
+  await waitForToolsToSettle(toolsRef, { ...options, emptyTimeoutMs: 2000 });
+  let elapsed = performance.now() - start;
+  assert.deepEqual(toolsRef.current.map((t) => t.name), ['get_order_summary']);
+  assert.ok(elapsed >= 340 && elapsed < 1000, `returned after ${elapsed}ms`);
+
+  // Still gives up at emptyTimeoutMs if nothing ever arrives.
+  toolsRef.current = [];
+  start = performance.now();
+  await waitForToolsToSettle(toolsRef, { ...options, emptyTimeoutMs: 400 });
+  elapsed = performance.now() - start;
+  assert.ok(elapsed >= 400 && elapsed < 900, `gave up after ${elapsed}ms`);
+});
