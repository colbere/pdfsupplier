# Copy this file to .env (or run `npm run setup`, which does it for you).
# Never paste real keys into chat, commits, or docs. .env is git-ignored.

# Stripe TEST key only. Restricted test keys (rk_test_...) are preferred, as
# Stripe recommends for AI agents. Secret test keys (sk_test_...) are also accepted.
# Any other key (including sk_live_ / rk_live_) makes the server refuse to start.
STRIPE_SECRET_KEY=rk_test_REPLACE_ME

# Admin password for the npm scripts (new-code, kill-switch, unlock).
# Leave this placeholder: `npm run setup` replaces it with a random value.
ADMIN_TOKEN=generated_by_npm_run_setup
