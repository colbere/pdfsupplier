// Wrangler settings for The PDF Supplier.
// Local: `npm run dev` (http://localhost:8787). Live: `npx wrangler deploy` to pdfsupplier.com
// (Stripe SANDBOX only; see docs/DECISIONS.md D27, D29 and docs/SECURITY.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pdf-supplier",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  // One public origin only: the custom domain. The default *.workers.dev address and preview
  // URLs are switched off, so cookies, limits and the origin-trial token all use one origin.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "pdfsupplier.com", "custom_domain": true },
    { "pattern": "www.pdfsupplier.com", "custom_domain": true }
  ],

  // Public, non-secret settings.
  // ORIGIN_TRIAL_TOKEN: Chrome's WebMCP origin-trial token for https://pdfsupplier.com (public by
  // design; sent as an Origin-Trial header on the page). Empty until registered.
  // CANONICAL_HOST: www.<host> is redirected here.
  "vars": {
    "ORIGIN_TRIAL_TOKEN": "",
    "CANONICAL_HOST": "pdfsupplier.com"
  },

  // Import the page HTML and the browser script as plain text strings
  // so the Worker can serve them. (.html is text by default; .browser.js is not.)
  "rules": [
    { "type": "Text", "globs": ["**/*.browser.js"], "fallthrough": true }
  ],

  // All state (codes, sessions, lockouts, orders) lives in one Durable Object.
  // See docs/DECISIONS.md D2.
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],

  // Load only these secrets from .env into the Worker. (.env also holds the Phase 2
  // agent's ANTHROPIC_API_KEY, which the store never needs.)
  "secrets": { "required": ["STRIPE_SECRET_KEY", "ADMIN_TOKEN"] },

  // Don't send anonymous usage data to Cloudflare.
  "send_metrics": false,

  "dev": {
    "port": 8787,
    "ip": "localhost",
    // Without this, `wrangler dev` presents requests as coming to the first route's domain
    // (pdfsupplier.com), so locally built links would point at the live site.
    "host": "localhost:8787",
    "local_protocol": "http"
  }
}
